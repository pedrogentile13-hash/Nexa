# Supabase — copy to .env.local and fill with your project values.
# Local dev: run `supabase start` and use the printed values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL, used for auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AI Studio (Gemini) — só necessária para "Transformar em estudo"
# (resumo/flashcards/quiz gerados a partir de um PDF) e para as recomendações
# do Loop Nexa. Enquanto não existir, upload/leitor/metadados de PDF
# funcionam normalmente; só a parte de IA fica desabilitada (ADR-039).
GEMINI_API_KEY=
