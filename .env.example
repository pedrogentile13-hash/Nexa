# Supabase — copy to .env.local and fill with your project values.
# Local dev: run `supabase start` and use the printed values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL, used for auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Groq (console.groq.com/keys) — chave gratuita, usada pela Nexa IA
# (/nexa-ia). Enquanto não existir, a tela funciona normalmente e a conversa
# fica salva, só a resposta vem com o texto fixo avisando que a IA ainda não
# está conectada.
GROQ_API_KEY=

# Push notifications reais (web-push) — gere com
# `npx web-push generate-vapid-keys`. NEXT_PUBLIC_VAPID_PUBLIC_KEY vai pro
# navegador (é assim que a Push API funciona); VAPID_PRIVATE_KEY nunca sai do
# servidor. VAPID_SUBJECT é um "mailto:" de contato, exigido pelo protocolo.
# Sem essas três, o sino de notificações continua funcionando normalmente —
# só o aviso com o app FECHADO não dispara.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@nexastudy.com.br

# Supabase service role — necessária só pro envio de push, que precisa ler a
# assinatura de OUTRO usuário (a RLS de push_subscriptions nunca deixaria
# isso pela chave anônima). Pegue em Project Settings → API → service_role,
# no painel do Supabase. NUNCA exponha esta chave no cliente nem a prefixe
# com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
